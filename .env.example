STRAPI_API_URL=https://strapi.caleblamcodes.dev/api
# Generate a random secret and set the same value in Strapi's webhook header.
STRAPI_WEBHOOK_SECRET=
# Optional: Used by browser, server, and edge Sentry SDKs. Set production on Railway before building.
# Without an override, the environment follows NODE_ENV (development or production).
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
