{
  "name": "portfolio-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write . && prettier \"src/**/*.scss\" \"**/*.md\" --write",
    "format:check": "biome format . && prettier \"src/**/*.scss\" \"**/*.md\" --check",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@sentry/nextjs": "^11.4.0",
    "@types/node": "26.6.4",
    "@types/qs": "^6.15.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bootstrap": "^5.3.8",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "nextjs-toploader": "^3.9.17",
    "qs": "^6.16.0",
    "react": "19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-paginate": "^8.3.0",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
